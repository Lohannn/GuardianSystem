  m_Name: Day1Cutscene
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  images:
  - level: 0
    image: {fileID: 21300000, guid: b3564bbe0b2551fb78b1865081389210, type: 3}
  - level: 1
